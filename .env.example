# Default: expose RemoteTerm on the Raspberry Pi LAN interfaces (port 8080).
# Use only on trusted LANs; set 127.0.0.1 for local-only access.
RASPMESH_BIND=0.0.0.0
# Existing compatible MeshCore Companion TCP endpoint.
MESHCORE_TCP_HOST=host.docker.internal
MESHCORE_TCP_PORT=5000
# RemoteTerm bots run arbitrary Python. Keep disabled until HTTPS/auth is configured.
MESHCORE_DISABLE_BOTS=true
